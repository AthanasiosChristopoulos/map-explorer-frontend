{
  "controls": {
    "fullscreen": true,
    "navigation": {
      "showZoom": true,
      "showCompass": false
    },
    "geolocateControl": {
        "positionOptions": {
            "enableHighAccuracy": true
        },
        "trackUserLocation": true,
        "showUserHeading": true
    }
  },
  "customPin": {
    "iconSize": 0.75,
    "iconAnchor": "bottom",
    "iconAllowOverlap": true
  },
  "map": {
    "container":"map",
    "style": "mapbox://styles/mapbox/streets-v12",
    "center": [-9.1399, 38.7169],
    "projection": "mercator",
    "dragRotate": false,
    "pitchWithRotate": false,
    "minZoom": 1.7,
    "zoom": 3,
    "maxBounds": [
      [-180, -85], 
      [180, 85]    
    ]
  },
  "pinLayerWithImage": {
        "id":"pin-layer",
        "type": "symbol",
        "source": "points",
        "layout": {
          "icon-image": "custom-pin",
          "icon-size": 0.75,
          "icon-anchor": "bottom",
          "icon-allow-overlap": true
        }
    },
    "pinLayerDefault": {
      "id": "pin-layer",
      "type": "circle",
      "source": "points",
      "paint": {
        "circle-radius": 6,
        "circle-color": "#D54552",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#FFFFFF"
      }
    },
    "popup": {
        "closeButton": false,
        "closeOnClick": false,
        "offset": 40        
    }

}
